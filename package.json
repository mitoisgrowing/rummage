{
  "name": "rummage",
  "productName": "Rummage",
  "version": "1.2.0",
  "description": "Samples, plugins and presets in one panel beside FL Studio or Ableton Live, with real plugin pictures.",
  "main": "main.js",
  "license": "MIT",
  "author": "mitoisgrowing",
  "keywords": [
    "ableton",
    "ableton-live",
    "sample-browser",
    "splice",
    "vst",
    "music-production",
    "electron",
    "fl-studio"
  ],
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.rummage.app",
    "productName": "Rummage",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**",
      "shots.js",
      "i18n.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rummage"
    },
    "extraResources": [
      {
        "from": "native/vst3snap.exe",
        "to": "vst3snap.exe"
      },
      {
        "from": "daw",
        "to": "daw"
      }
    ]
  },
  "homepage": "https://github.com/mitoisgrowing/rummage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitoisgrowing/rummage.git"
  },
  "bugs": {
    "url": "https://github.com/mitoisgrowing/rummage/issues"
  }
}
